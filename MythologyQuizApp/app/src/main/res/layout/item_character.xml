<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="#1A237E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="center">

        <!-- Character image (local drawable) -->
        <ImageView
            android:id="@+id/ivCharacterImage"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            android:contentDescription="캐릭터" />

        <!-- Emoji (fallback) -->
        <TextView
            android:id="@+id/tvCharacterEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="40sp"
            android:layout_marginBottom="8dp" />

        <!-- Korean Name -->
        <TextView
            android:id="@+id/tvCharacterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="제우스"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center" />

        <!-- Greek Name -->
        <TextView
            android:id="@+id/tvCharacterGreek"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zeus"
            android:textSize="12sp"
            android:textColor="#90CAF9"
            android:gravity="center" />

        <!-- Category -->
        <TextView
            android:id="@+id/tvCharacterCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="올림포스 12신"
            android:textSize="10sp"
            android:textColor="#64B5F6"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_chip_blue"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />

        <!-- Difficulty stars -->
        <TextView
            android:id="@+id/tvDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★"
            android:textSize="12sp"
            android:textColor="#FFD700"
            android:layout_marginTop="4dp" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
